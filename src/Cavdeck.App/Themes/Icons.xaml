  <StreamGeometry x:Key="IconMediaPlay">M5,3.2 L12.2,8 L5,12.8 Z</StreamGeometry>
  <StreamGeometry x:Key="IconMediaPause">M5.3,3.5 V12.5 M10.7,3.5 V12.5</StreamGeometry>
  <StreamGeometry x:Key="IconMediaBackward">M7.5,4.4 L3.4,8 L7.5,11.6 Z M12.8,4.4 L8.7,8 L12.8,11.6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconMediaForward">M3.2,4.4 L7.3,8 L3.2,11.6 Z M8.5,4.4 L12.6,8 L8.5,11.6 Z</StreamGeometry>
  <StreamGeometry x:Key="IconMediaVolume">M2.8,6 H5.2 L8.3,3.5 V12.5 L5.2,10 H2.8 Z M10.3,5.6 Q12.9,8 10.3,10.4 M11.7,3.6 Q16,8 11.7,12.4</StreamGeometry>
  <StreamGeometry x:Key="IconMediaMuted">M2.8,6 H5.2 L8.3,3.5 V12.5 L5.2,10 H2.8 Z M10.5,5.5 L13.5,10.5 M13.5,5.5 L10.5,10.5</StreamGeometry>
