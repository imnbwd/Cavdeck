  <StreamGeometry x:Key="IconResume">M5,3.4 L12,8 L5,12.6 Z</StreamGeometry>

  <Style x:Key="IconGlyph" TargetType="Path">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- Tray glyphs inherit from the same dictionary so deferred StaticResource
       resolution works independently of other merged dictionaries. -->
  <Style x:Key="TrayIconStyle" TargetType="Path" BasedOn="{StaticResource IconGlyph}">
    <Setter Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
  </Style>

  <!-- Generic S3 endpoint is the default; keep it distinct from bucket navigation. -->
  <Style x:Key="ProviderGlyphStyle" TargetType="{x:Type controls:ProviderGlyph}">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:ProviderGlyph}">
          <Path x:Name="ProviderPath" Style="{StaticResource IconGlyph}"
                Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                Stretch="Uniform" Stroke="{TemplateBinding Foreground}"
                Data="{StaticResource IconProviderS3Compatible}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="Provider" Value="{x:Static domain:StorageProviderKind.AwsS3}">
              <Setter TargetName="ProviderPath" Property="Data" Value="{StaticResource IconProviderAwsS3}"/>
            </Trigger>
            <Trigger Property="Provider" Value="{x:Static domain:StorageProviderKind.CloudflareR2}">
              <Setter TargetName="ProviderPath" Property="Data" Value="{StaticResource IconProviderCloudflareR2}"/>
            </Trigger>
            <Trigger Property="Provider" Value="{x:Static domain:StorageProviderKind.Minio}">
              <Setter TargetName="ProviderPath" Property="Data" Value="{StaticResource IconProviderMinio}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
