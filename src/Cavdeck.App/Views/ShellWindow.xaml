<controls:AppWindow x:Class="Cavdeck.App.Views.ShellWindow"
        x:Name="ShellRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cavdeck.App.Controls"
        xmlns:converters="clr-namespace:Cavdeck.App.Controls.Converters"
        xmlns:shell="clr-namespace:Cavdeck.Application.Shell;assembly=Cavdeck.Application"
        xmlns:connections="clr-namespace:Cavdeck.App.Features.Connections"
        xmlns:explorer="clr-namespace:Cavdeck.App.Features.Explorer"
        xmlns:places="clr-namespace:Cavdeck.App.Features.Places"
        xmlns:transfers="clr-namespace:Cavdeck.App.Features.Transfers"
        xmlns:settings="clr-namespace:Cavdeck.App.Features.Settings"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding Texts[Brand_Name]}" Width="1120" Height="740" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <controls:AppWindow.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BoolVis"/>
    <converters:ConnectionMarkConverter x:Key="ConnectionMark"/>
    <converters:ConnectionPresentConverter x:Key="ConnectionPresent"/>
    <converters:StringToVisibilityConverter x:Key="StringVis"/>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding EffectiveSidebarCollapsed}" Value="True">
          <Setter Property="HorizontalContentAlignment" Value="Center"/>
          <Setter Property="Padding" Value="0"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Compact storage picker: 52-DIP rows for a legible two-line hierarchy.
         Reuse the app's hover, focus and pressed feedback rather than the native button chrome. -->
    <Style x:Key="StorageMenuConnectionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Height" Value="52"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="TabSelectButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="10,0,30,0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style x:Key="TabCloseButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="MinWidth" Value="24"/>
      <Setter Property="MinHeight" Value="24"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding CanClose}" Value="False">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="IsHitTestVisible" Value="False"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="IsHitTestVisible" Value="True"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="IsHitTestVisible" Value="True"/>
        </DataTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="IsHitTestVisible" Value="True"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type connections:ConnectionWorkspace}">
      <connections:ConnectionsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type explorer:ExplorerWorkspace}">
      <explorer:ExplorerView/>
    </DataTemplate>
  </controls:AppWindow.Resources>

  <controls:AppWindow.TitleBarCenter>
    <Grid x:Name="TabHost" VerticalAlignment="Center" SizeChanged="TabHost_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer x:Name="TabScroller" Grid.Column="0" HorizontalAlignment="Left"
                    HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Focusable="False" PreviewMouseWheel="TabList_PreviewMouseWheel">
        <ItemsControl x:Name="TabList" Height="32" ItemsSource="{Binding Tabs}" SizeChanged="TabHost_SizeChanged"
                      PreviewMouseLeftButtonDown="TabList_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="TabList_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="TabList_PreviewMouseLeftButtonUp"
                      PreviewMouseDown="TabList_PreviewMouseDown"
                      MouseLeave="TabList_MouseLeave">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="TabChrome" Height="32"
                      Width="{Binding TabItemWidth, RelativeSource={RelativeSource AncestorType={x:Type controls:AppWindow}}}"
                      Margin="0,0,4,0"
                      CornerRadius="6" SnapsToDevicePixels="True" ToolTip="{Binding FullTitle}">
                <Border.ContextMenu>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                               Opened="TabMenu_Opened">
                    <MenuItem Header="{Binding DuplicateLabel}" Click="TabDuplicate_Click"/>
                    <MenuItem Header="{Binding CloseOthersLabel}"
                              Click="TabCloseOthers_Click"/>
                    <MenuItem Header="{Binding RestoreClosedLabel}"
                              Click="TabRestoreClosed_Click"/>
                  </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                      </Trigger>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Button Style="{StaticResource TabSelectButton}"
                          Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Title}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0">
                        <Path Data="{StaticResource IconConnections}">
                          <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                              <Setter Property="Stretch" Value="Uniform"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Favorites}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Recent}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Transfers}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Explorer}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Settings}">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <Path Data="{StaticResource IconFolder}">
                          <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                              <Setter Property="Stretch" Value="Uniform"/>
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Explorer}">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <Path Data="{StaticResource IconStar}">
                          <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                              <Setter Property="Stretch" Value="Uniform"/>
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Favorites}">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <Path Data="{StaticResource IconClock}">
                          <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                              <Setter Property="Stretch" Value="Uniform"/>
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Recent}">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <Path Data="{StaticResource IconTransfers}">
                          <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                              <Setter Property="Stretch" Value="Uniform"/>
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Transfers}">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                        <Path Data="{StaticResource IconSettings}">
                          <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                              <Setter Property="Stretch" Value="Uniform"/>
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Page}" Value="{x:Static shell:ShellPage.Settings}">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Path.Style>
                        </Path>
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                      <Ellipse Grid.Column="2" Width="6" Height="6" Margin="5,0,0,0" VerticalAlignment="Center"
                               Fill="{DynamicResource AccentBrush}"
                               ToolTip="{Binding DataContext.Texts[Tab_UnsavedChanges], RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                               Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolVis}}"/>
                    </Grid>
                  </Button>
                  <Button Tag="close" Style="{StaticResource TabCloseButton}" HorizontalAlignment="Right"
                          Margin="0,0,4,0" Panel.ZIndex="2"
                          PreviewMouseLeftButtonDown="TabCloseButton_PreviewMouseLeftButtonDown"
                          Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}"
                          ToolTip="{Binding DataContext.CloseTip, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          AutomationProperties.Name="{Binding DataContext.CloseTip, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                    <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconClose}"
                          Width="10" Height="10" Stretch="Uniform"/>
                  </Button>
                  <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" CornerRadius="1"
                          Background="{DynamicResource AccentBrush}" IsHitTestVisible="False">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Button x:Name="NewTabButton" Grid.Column="1" Style="{StaticResource IconButton}" Margin="4,0,0,0"
              Command="{Binding NewTabCommand}" ToolTip="{Binding NewTabTip}"
              AutomationProperties.Name="{Binding Texts[Tab_NewTip]}">
        <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconPlus}" Width="16" Height="16" Stretch="Uniform"/>
      </Button>
      <Button x:Name="TabOverflowButton" Grid.Column="2" Style="{StaticResource IconButton}"
              HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="Collapsed"
              Click="TabOverflow_Click" ToolTip="{Binding Texts[Tab_AllTabs]}"
              AutomationProperties.Name="{Binding Texts[Tab_AllTabs]}">
        <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconChevronDown}"
              Width="16" Height="16" Stretch="Uniform"/>
      </Button>
    </Grid>
  </controls:AppWindow.TitleBarCenter>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="200" MaxWidth="340"/>
        <ColumnDefinition x:Name="SplitterColumn" Width="5"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
              PreviewMouseDown="Sidebar_PreviewMouseDown">
        <Grid>
        <DockPanel Margin="8,12,8,8">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,8" MinHeight="38">
            <TextBlock Text="{Binding Texts[Nav_Workspace]}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,44,0"
                       Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
            <Button Command="{Binding ToggleSidebarCommand}"
                    ToolTip="{Binding SidebarToggleTip}"
                    AutomationProperties.Name="{Binding SidebarToggleTip}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                  <Setter Property="HorizontalAlignment" Value="Right"/>
                  <Setter Property="HorizontalContentAlignment" Value="Center"/>
                  <Setter Property="Width" Value="36"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,1,4,1"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding EffectiveSidebarCollapsed}" Value="True">
                      <Setter Property="HorizontalAlignment" Value="Stretch"/>
                      <Setter Property="Width" Value="Auto"/>
                      <Setter Property="Margin" Value="0,1"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconSidebar}"
                    Width="16" Height="16" Stretch="Uniform"/>
            </Button>
          </Grid>

          <Grid DockPanel.Dock="Bottom" Margin="0,7,0,3">
            <Button Command="{Binding ShowSettingsCommand}"
                    ToolTip="{Binding Texts[Settings_Title]}"
                    AutomationProperties.Name="{Binding Texts[Settings_Title]}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}"/>
                      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                      <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconSettings}"
                      Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="{Binding Texts[Settings_Title]}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
              </StackPanel>
            </Button>
          </Grid>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
              <Button Tag="connections" Click="Nav_Click"
                      ToolTip="{Binding Texts[Nav_ConnectionsTip]}"
                      AutomationProperties.Name="{Binding Texts[Nav_Connections]}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                          <Condition Binding="{Binding ActivePage}" Value="{x:Static shell:ShellPage.Connections}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconConnections}" Width="16" Height="16" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Texts[Nav_Connections]}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                </StackPanel>
              </Button>
              <Button Tag="favorites" Click="Nav_Click"
                      ToolTip="{Binding Texts[Nav_FavoritesTip]}"
                      AutomationProperties.Name="{Binding Texts[Nav_Favorites]}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                          <Condition Binding="{Binding ActivePage}" Value="{x:Static shell:ShellPage.Favorites}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconStar}" Width="16" Height="16" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Texts[Nav_Favorites]}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                </StackPanel>
              </Button>
              <Button Tag="recent" Click="Nav_Click"
                      ToolTip="{Binding Texts[Nav_RecentTip]}"
                      AutomationProperties.Name="{Binding Texts[Nav_Recent]}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                          <Condition Binding="{Binding ActivePage}" Value="{x:Static shell:ShellPage.Recent}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconClock}" Width="16" Height="16" Stretch="Uniform"/>
                  <TextBlock Text="{Binding Texts[Nav_Recent]}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                </StackPanel>
              </Button>
              <Button Tag="transfers" Click="Nav_Click"
                      ToolTip="{Binding Texts[Nav_TransfersTip]}"
                      AutomationProperties.Name="{Binding Texts[Nav_Transfers]}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                          <Condition Binding="{Binding ActivePage}" Value="{x:Static shell:ShellPage.Transfers}"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Grid Width="16" Height="16" Margin="0,0,0,0">
                    <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconTransfers}"
                          Width="16" Height="16" Stretch="Uniform"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="14" Height="14"
                            Margin="0,-6,-6,0" CornerRadius="7" Padding="3,0"
                            Background="{DynamicResource AccentBrush}">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Transfers.ShowPendingTransferCount}" Value="True"/>
                                <Condition Binding="{Binding EffectiveSidebarCollapsed}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding Transfers.PendingTransferCount}" FontSize="10"
                                 Foreground="{DynamicResource OnAccentBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Path Data="{StaticResource IconWarning}" Width="12" Height="12" Stretch="Uniform"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-6,-6"
                          ToolTip="{Binding Texts[Transfer_FailedMarkTip]}"
                          Visibility="{Binding Transfers.HasFailedTransfers, Converter={StaticResource BoolVis}}">
                      <Path.Style>
                        <Style TargetType="Path" BasedOn="{StaticResource IconGlyph}">
                          <Setter Property="Stroke" Value="{DynamicResource DangerTextBrush}"/>
                        </Style>
                      </Path.Style>
                    </Path>
                  </Grid>
                  <TextBlock Text="{Binding Texts[Nav_Transfers]}" Margin="10,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                  <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="8" VerticalAlignment="Center"
                          Background="{DynamicResource SubtleAccentBrush}">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Transfers.ShowPendingTransferCount}" Value="True"/>
                              <Condition Binding="{Binding EffectiveSidebarCollapsed}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Transfers.PendingTransferCount}" FontSize="11"
                               Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
              </Button>
              <Separator x:Name="CompactStorageSeparator"
                         Margin="8,8,8,8"
                         Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}}"/>
              <Button x:Name="StorageNavButton"
                      Command="{Binding ToggleStorageMenuCommand}"
                      PreviewMouseLeftButtonDown="StorageNavButton_PreviewMouseLeftButtonDown"
                      ToolTip="{Binding Texts[Nav_StorageTip]}"
                      AutomationProperties.Name="{Binding Texts[Nav_StorageTip]}"
                      Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding ShowExplorer}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconBucket}"
                      Width="16" Height="16" Stretch="Uniform"/>
              </Button>
              <StackPanel Margin="0,12,0,0"
                          Visibility="{Binding EffectiveSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <Separator Margin="8,0,8,12"/>
                <Grid Margin="8,0,4,8">
                  <TextBlock Text="{Binding Texts[Nav_Storage]}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                  <Button HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                          Style="{StaticResource IconButton}"
                          Command="{Binding AddSidebarConnectionCommand}"
                          ToolTip="{Binding Texts[Connection_Add]}"
                          AutomationProperties.Name="{Binding Texts[Connection_Add]}">
                    <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconPlus}"
                          Width="14" Height="14" Stretch="Uniform"/>
                  </Button>
                </Grid>
                <TextBlock Text="{Binding Texts[Nav_EmptyConnections]}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,4" FontSize="12"
                           Visibility="{Binding Connections.ShowSidebarEmpty, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{Binding Texts[Nav_LoadingConnections]}" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,8,4" FontSize="12"
                           Visibility="{Binding Connections.ShowSidebarLoading, Converter={StaticResource BoolVis}}"/>
                <StackPanel Margin="8,0,8,6"
                            Visibility="{Binding Connections.ShowSidebarError, Converter={StaticResource BoolVis}}">
                  <TextBlock Text="{Binding Connections.LoadError}" TextWrapping="Wrap" FontSize="12"
                             Foreground="{DynamicResource DangerTextBrush}" Margin="0,0,0,6"/>
                  <Button Content="{Binding Texts[Nav_RetryConnections]}" Height="32"
                          Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                          Command="{Binding Connections.ReloadCommand}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Connections.Items}"
                              Visibility="{Binding Connections.HasConnections, Converter={StaticResource BoolVis}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid x:Name="ConnectionRow" Margin="0,1">
                      <Button x:Name="ConnectionPrimaryButton" Height="36" Margin="0" HorizontalContentAlignment="Stretch"
                              Command="{Binding DataContext.OpenConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Id}"
                              AutomationProperties.Name="{Binding Name}"
                              AutomationProperties.HelpText="{Binding ProviderLabel}"
                              PreviewMouseDown="StorageConnection_PreviewMouseDown"
                              Tag="{Binding Id}">
                        <Button.ToolTip>
                          <StackPanel MaxWidth="280">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProviderLabel}" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                          </StackPanel>
                        </Button.ToolTip>
                        <Button.ContextMenu>
                          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding DataContext.Texts[Explorer_Open], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.OpenConnectionCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding Id}">
                              <MenuItem.Icon><Path Style="{StaticResource ContextMenuIconStyle}" Data="{StaticResource IconTrayOpen}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_OpenNewTab], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.OpenConnectionNewTabCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding Id}">
                              <MenuItem.Icon><Path Style="{StaticResource ContextMenuIconStyle}" Data="{StaticResource IconOpenNewTab}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_Edit], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.EditSidebarConnectionCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_Test], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.Connections.TestStoredCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_Delete], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.Connections.DeleteCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding}" controls:MenuAssist.IsDanger="True">
                              <MenuItem.Icon><Path Style="{StaticResource ContextMenuDangerIconStyle}" Data="{StaticResource IconTrash}"/></MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                            <Setter Property="Padding" Value="8,0"/>
                          </Style>
                        </Button.Style>
                        <!-- Reserve action space at rest as well as hover to prevent label clipping or jumping. -->
                        <Grid Margin="0,0,32,0">
                          <!-- Fixed marker height avoids shrinking to the one-line text's natural height. -->
                          <Border Width="3" Height="24" VerticalAlignment="Center"
                                  HorizontalAlignment="Left" Margin="-8,0,0,0" CornerRadius="1.5">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                  <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                      <MultiBinding Converter="{StaticResource ConnectionMark}">
                                        <Binding Path="Id"/>
                                        <Binding Path="DataContext.ActiveConnectionId" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                      </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                          </Border>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*" MinWidth="0"/>
                            </Grid.ColumnDefinitions>
                            <controls:ProviderGlyph Grid.Column="0" Style="{StaticResource ProviderGlyphStyle}"
                                                    Provider="{Binding Connection.Provider}" Margin="0,0,8,0"
                                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </Grid>
                      </Button>
                      <Button Width="28" Height="28" MinWidth="28" MinHeight="28"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                              Padding="0" Click="SidebarConnectionMore_Click"
                              Tag="{Binding ElementName=ConnectionPrimaryButton}"
                              ToolTip="{Binding DataContext.Texts[Nav_MoreConnectionActions], Source={x:Reference ShellRoot}}"
                              AutomationProperties.Name="{Binding DataContext.Texts[Nav_MoreConnectionActions], Source={x:Reference ShellRoot}}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Opacity" Value="0"/>
                            <Setter Property="IsHitTestVisible" Value="False"/>
                            <Setter Property="IsTabStop" Value="False"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsMouseOver, ElementName=ConnectionRow}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=ConnectionRow}" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="IsHitTestVisible" Value="True"/>
                                <Setter Property="IsTabStop" Value="True"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconMoreHorizontal}"
                              Width="16" Height="16" Stretch="Uniform"/>
                      </Button>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
        <Popup x:Name="StorageMenu"
               DataContext="{Binding DataContext, ElementName=ShellRoot}"
               PlacementTarget="{Binding ElementName=StorageNavButton}"
               Placement="Right" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="None"
               IsOpen="{Binding IsStorageMenuOpen, Mode=TwoWay}"
               Opened="StorageMenu_Opened">
          <Border Width="288" MaxHeight="360" Padding="6" Margin="4,4,12,14"
                  UseLayoutRounding="True" SnapsToDevicePixels="True"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                  CornerRadius="{DynamicResource RadiusMedium}"
                  PreviewKeyDown="StorageMenu_PreviewKeyDown">
            <Border.Effect>
              <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270"
                                Opacity="0.16" Color="#1B2430"/>
            </Border.Effect>
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                <Separator Style="{StaticResource ContextMenuSeparatorStyle}" Margin="10,0,10,6"/>
                <Button x:Name="StorageMenuAddButton" Height="36" Padding="12,0"
                        HorizontalContentAlignment="Left" Style="{StaticResource GhostButton}"
                        Command="{Binding AddSidebarConnectionCommand}"
                        AutomationProperties.Name="{Binding Texts[Connection_Add]}">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconPlus}"
                          Width="16" Height="16" Stretch="Uniform" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding Texts[Connection_Add]}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel DockPanel.Dock="Top"
                          Visibility="{Binding Connections.ShowSidebarEmpty, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Texts[Nav_EmptyConnections]}"
                           TextWrapping="Wrap" Margin="8,4,8,8" FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"/>
              </StackPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Texts[Nav_LoadingConnections]}"
                         TextWrapping="Wrap" Margin="8,4,8,8" FontSize="12"
                         Foreground="{DynamicResource MutedTextBrush}"
                         Visibility="{Binding Connections.ShowSidebarLoading, Converter={StaticResource BoolVis}}"/>
              <StackPanel DockPanel.Dock="Top" Margin="8,4,8,8"
                          Visibility="{Binding Connections.ShowSidebarError, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding Connections.LoadError}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource DangerTextBrush}" Margin="0,0,0,6"/>
                <Button Content="{Binding Texts[Nav_RetryConnections]}" Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left" Height="32" Command="{Binding Connections.ReloadCommand}"/>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="StorageMenuList" ItemsSource="{Binding Connections.Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource StorageMenuConnectionButton}"
                              Command="{Binding DataContext.OpenConnectionCommand, Source={x:Reference ShellRoot}}"
                              CommandParameter="{Binding Id}"
                              Tag="{Binding Id}"
                              AutomationProperties.Name="{Binding Name}"
                              AutomationProperties.HelpText="{Binding ProviderLabel}"
                              PreviewMouseDown="StorageConnection_PreviewMouseDown"
                              PreviewMouseRightButtonDown="StorageMenuRow_PreviewMouseRightButtonDown">
                        <!-- Show complete labels only on demand; keep rows compact and consistently aligned. -->
                        <Button.ToolTip>
                          <StackPanel MaxWidth="320">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProviderLabel}" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Button.ToolTip>
                        <Button.ContextMenu>
                          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                       Closed="StorageMenuRowMenu_Closed">
                            <MenuItem Header="{Binding DataContext.Texts[Explorer_Open], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.OpenConnectionCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding Id}">
                              <MenuItem.Icon><Path Style="{StaticResource ContextMenuIconStyle}" Data="{StaticResource IconTrayOpen}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_OpenNewTab], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.OpenConnectionNewTabCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding Id}">
                              <MenuItem.Icon><Path Style="{StaticResource ContextMenuIconStyle}" Data="{StaticResource IconOpenNewTab}"/></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_Edit], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.EditSidebarConnectionCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_Test], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.Connections.TestStoredCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding}"/>
                            <MenuItem Header="{Binding DataContext.Texts[Connection_Delete], Source={x:Reference ShellRoot}}"
                                      Command="{Binding DataContext.Connections.DeleteCommand, Source={x:Reference ShellRoot}}"
                                      CommandParameter="{Binding}" controls:MenuAssist.IsDanger="True">
                              <MenuItem.Icon><Path Style="{StaticResource ContextMenuDangerIconStyle}" Data="{StaticResource IconTrash}"/></MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*" MinWidth="0"/>
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Width="2" Height="28" VerticalAlignment="Center" CornerRadius="1">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                  <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                      <MultiBinding Converter="{StaticResource ConnectionMark}">
                                        <Binding Path="Id"/>
                                        <Binding Path="DataContext.ActiveConnectionId" Source="{x:Reference ShellRoot}"/>
                                      </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                          </Border>
                          <controls:ProviderGlyph Grid.Column="2" Style="{StaticResource ProviderGlyphStyle}"
                                                  Provider="{Binding Connection.Provider}"
                                                  VerticalAlignment="Center"/>
                          <Grid Grid.Column="4" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Name}"
                                       FontWeight="SemiBold" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="{Binding ProviderLabel}"
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                          </Grid>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Popup>
        </Grid>
      </Border>

      <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    DragStarted="SidebarSplitter_DragStarted"
                    DragCompleted="SidebarSplitter_DragCompleted"
                    MouseDoubleClick="SidebarSplitter_MouseDoubleClick"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource WorkspaceHeader}"
                 Visibility="{Binding ShowPageHeading, Converter={StaticResource BoolVis}}">
           <Grid>
             <TextBlock Text="{Binding PageTitle}" Style="{StaticResource TextTitle}"
                        VerticalAlignment="Center"
                       Visibility="{Binding ShowConnectionBack, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
            <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                    Style="{StaticResource GhostButton}" MinHeight="32" Padding="8,0"
                    Command="{Binding ReturnToConnectionListCommand}"
                    Visibility="{Binding ShowConnectionBack, Converter={StaticResource BoolVis}}"
                    AutomationProperties.Name="{Binding Texts[Connection_Back]}">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconChevronLeft}"
                      Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="{Binding Texts[Connection_Back]}" Margin="8,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False"
                        Visibility="{Binding ShowTabContent, Converter={StaticResource BoolVis}}"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                </Grid>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Grid.Row" Value="0"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <ContentControl Content="{Binding Workspace}" Focusable="False"
                                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <places:PlacesView DataContext="{Binding FavoritesPage}"
                             Visibility="{Binding DataContext.ShowFavorites, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>

          <places:PlacesView DataContext="{Binding RecentPage}"
                             Visibility="{Binding DataContext.ShowRecent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>

          <transfers:TransfersView Visibility="{Binding ShowTransfers, Converter={StaticResource BoolVis}}"/>
          <settings:SettingsView DataContext="{Binding Settings}"
                                 Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
        </Grid>
      </Grid>
    </Grid>

    <controls:ToastHost x:Name="Toasts" Grid.Row="0" Panel.ZIndex="20"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"/>

    <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource WindowBackgroundBrush}">
      <DockPanel Margin="16,0" LastChildFill="True">
        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusRight}" FontSize="12"
                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusLeft}" FontSize="12" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
  </Grid>
</controls:AppWindow>
