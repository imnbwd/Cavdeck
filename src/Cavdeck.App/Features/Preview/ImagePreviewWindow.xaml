<controls:AppWindow x:Class="Cavdeck.App.Features.Preview.ImagePreviewWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Cavdeck.App.Controls"
                    xmlns:preview="clr-namespace:Cavdeck.App.Features.Preview"
                    Title="{Binding Title}"
                    Style="{StaticResource AppWindowStyle}"
                    WindowState="Maximized"
                    Width="1160" Height="780"
                    MinWidth="640" MinHeight="440"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="CanResize"
                    UseLayoutRounding="True" SnapsToDevicePixels="True"
                    PreviewKeyDown="Window_PreviewKeyDown">
  <controls:AppWindow.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <Style x:Key="ViewerToolbarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Height" Value="36"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Margin" Value="3,0"/>
    </Style>
  </controls:AppWindow.Resources>

  <Grid Background="{DynamicResource WindowBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid x:Name="Viewport" Grid.Row="0" ClipToBounds="True"
          Background="{DynamicResource SurfaceMutedBrush}"
          SizeChanged="Viewport_SizeChanged"
          MouseWheel="Viewport_MouseWheel"
          MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
          MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
          MouseMove="Viewport_MouseMove"
          LostMouseCapture="Viewport_LostMouseCapture"
          ToolTip="{Binding Texts[ImageViewer_Hint]}">
      <Image x:Name="CanvasImage" Source="{Binding Image}"
             HorizontalAlignment="Center" VerticalAlignment="Center"
             Stretch="Fill" IsHitTestVisible="False"
             RenderOptions.BitmapScalingMode="HighQuality"
             SnapsToDevicePixels="True">
        <Image.RenderTransform>
          <MatrixTransform/>
        </Image.RenderTransform>
      </Image>

      <preview:PreviewFeedbackView Panel.ZIndex="2"
                  Visibility="{Binding ShowFeedback, Converter={StaticResource BoolVis}}"
                  Headline="{Binding FeedbackTitle}"
                  Description="{Binding Error}"
                  ShowProgress="{Binding IsLoading}"
                  IsIndeterminate="True"
                  PrimaryButtonText="{Binding Texts[ImageViewer_Retry]}"
                  PrimaryCommand="{Binding RetryCommand}"
                  ShowPrimaryButton="{Binding ShowError}"/>

      <Button Style="{StaticResource ViewerToolbarButton}"
              Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}"
              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
              ToolTip="{Binding Texts[ImageViewer_Previous]}"
              AutomationProperties.Name="{Binding Texts[ImageViewer_Previous]}">
        <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconChevronLeft}"/>
      </Button>
      <Button Style="{StaticResource ViewerToolbarButton}"
              Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
              ToolTip="{Binding Texts[ImageViewer_Next]}"
              AutomationProperties.Name="{Binding Texts[ImageViewer_Next]}">
        <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconChevronRight}"/>
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,9">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding PixelSize}" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedTextBrush}"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ViewerToolbarButton}" Click="ZoomOut_Click"
                  IsEnabled="{Binding HasImage}"
                  ToolTip="{Binding Texts[ImageViewer_ZoomOut]}"
                  AutomationProperties.Name="{Binding Texts[ImageViewer_ZoomOut]}">
            <TextBlock Text="−" FontSize="19"/>
          </Button>
          <TextBlock x:Name="ZoomText" Text="100%" Width="62" TextAlignment="Center"
                     VerticalAlignment="Center" FontWeight="SemiBold"
                     AutomationProperties.Name="{Binding Texts[ImageViewer_ZoomLevel]}"/>
          <Button Style="{StaticResource ViewerToolbarButton}" Click="ZoomIn_Click"
                  IsEnabled="{Binding HasImage}"
                  ToolTip="{Binding Texts[ImageViewer_ZoomIn]}"
                  AutomationProperties.Name="{Binding Texts[ImageViewer_ZoomIn]}">
            <TextBlock Text="+" FontSize="19"/>
          </Button>
          <Border Width="1" Height="22" Margin="8,0"
                  Background="{DynamicResource BorderBrush}"/>
          <Button Style="{StaticResource ViewerToolbarButton}" Click="Fit_Click"
                  IsEnabled="{Binding HasImage}"
                  Content="{Binding Texts[ImageViewer_Fit]}"
                  ToolTip="{Binding Texts[ImageViewer_FitTip]}"
                  AutomationProperties.Name="{Binding Texts[ImageViewer_Fit]}"/>
          <Button Style="{StaticResource ViewerToolbarButton}" Click="Actual_Click"
                  IsEnabled="{Binding HasImage}"
                  Content="{Binding Texts[ImageViewer_ActualSize]}"
                  ToolTip="{Binding Texts[ImageViewer_ActualTip]}"
                  AutomationProperties.Name="{Binding Texts[ImageViewer_ActualSize]}"/>
        </StackPanel>

        <TextBlock Grid.Column="2" Text="{Binding PositionLabel}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontWeight="SemiBold"
                   Foreground="{DynamicResource MutedTextBrush}"/>
      </Grid>
    </Border>
  </Grid>
</controls:AppWindow>
