<UserControl x:Class="Cavdeck.App.Features.Preview.PreviewProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="12" MaxWidth="320" VerticalAlignment="Center"
                HorizontalAlignment="Stretch">
      <TextBlock Text="{Binding Texts[Preview_Downloading]}" FontWeight="SemiBold"
                 TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
      <ProgressBar Style="{StaticResource ThemedProgressBar}" Height="6" Minimum="0" Maximum="100"
                   Value="{Binding PreviewProgress, Mode=OneWay}"
                   AutomationProperties.Name="{Binding Texts[Preview_Downloading]}"/>
      <TextBlock Text="{Binding PreviewProgressLabel}" Foreground="{DynamicResource MutedTextBrush}"
                 HorizontalAlignment="Center" Margin="0,10,0,16"
                 AutomationProperties.LiveSetting="Polite"/>
      <Button Content="{Binding Texts[Preview_CancelDownload]}"
              Style="{StaticResource SecondaryButton}"
              HorizontalAlignment="Center" Padding="16,0" Height="32"
              Command="{Binding CancelPreviewCommand}"
              AutomationProperties.Name="{Binding Texts[Preview_CancelDownload]}"/>
    </StackPanel>
  </Border>
</UserControl>
