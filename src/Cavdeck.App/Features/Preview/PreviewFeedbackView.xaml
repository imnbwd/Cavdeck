<UserControl x:Class="Cavdeck.App.Features.Preview.PreviewFeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:preview="clr-namespace:Cavdeck.App.Features.Preview"
             xmlns:converters="clr-namespace:Cavdeck.App.Controls.Converters"
             Focusable="False">
  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="FeedbackBoolVis"/>
    <converters:StringToVisibilityConverter x:Key="FeedbackStringVis"/>
  </UserControl.Resources>
  <Grid Background="Transparent">
    <Border MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="16" Padding="24,22"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="{DynamicResource RadiusMedium}">
      <StackPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type preview:PreviewFeedbackView}}}"
                  TextBlock.TextAlignment="Center">
        <Path Style="{StaticResource PageEmptyGlyph}"
              Data="{StaticResource IconGenericFile}"
              Stroke="{DynamicResource MutedTextBrush}"
              HorizontalAlignment="Center" Margin="0,0,0,14" IsHitTestVisible="False"/>
        <TextBlock Text="{Binding Headline}" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   TextWrapping="Wrap" MaxWidth="380"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="{Binding Description}" Margin="0,7,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" MaxWidth="380"
                   Visibility="{Binding Description, Converter={StaticResource FeedbackStringVis}}"/>
        <ProgressBar Height="6" Minimum="0" Maximum="100"
                     Margin="0,16,0,0" Value="{Binding ProgressValue}"
                     IsIndeterminate="{Binding IsIndeterminate}"
                     Style="{StaticResource ThemedProgressBar}"
                     Visibility="{Binding ShowProgress, Converter={StaticResource FeedbackBoolVis}}"
                     AutomationProperties.Name="{Binding Headline}"/>
        <TextBlock Text="{Binding ProgressDescription}" Margin="0,8,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Visibility="{Binding ProgressDescription, Converter={StaticResource FeedbackStringVis}}"/>
        <WrapPanel HorizontalAlignment="Center" Margin="0,14,0,0">
          <Button Content="{Binding PrimaryButtonText}" Command="{Binding PrimaryCommand}"
                  Style="{StaticResource PrimaryButton}" Padding="16,0" Height="34"
                  Visibility="{Binding ShowPrimaryButton, Converter={StaticResource FeedbackBoolVis}}"
                  AutomationProperties.Name="{Binding PrimaryButtonText}"/>
          <Button Content="{Binding SecondaryButtonText}" Command="{Binding SecondaryCommand}"
                  Style="{StaticResource SecondaryButton}" Padding="16,0" Height="34"
                  Margin="8,0,0,0"
                  Visibility="{Binding ShowSecondaryButton, Converter={StaticResource FeedbackBoolVis}}"
                  AutomationProperties.Name="{Binding SecondaryButtonText}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
