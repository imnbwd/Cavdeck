<UserControl x:Class="Cavdeck.App.Features.Places.PlacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Cavdeck.App.Controls"
             xmlns:converters="clr-namespace:Cavdeck.App.Controls.Converters">
  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BoolVis"/>
    <Style x:Key="PlaceTool" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="32"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
    <Style x:Key="PlaceToolDanger" TargetType="Button" BasedOn="{StaticResource PlaceTool}">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
    </Style>
    <Style x:Key="PlaceToolDivider" TargetType="Border">
      <Setter Property="Width" Value="1"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>
    <Style x:Key="PlaceGlyph" TargetType="Path" BasedOn="{StaticResource IconGlyph}">
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="Data" Value="{StaticResource IconFolder}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBucket}" Value="True">
          <Setter Property="Data" Value="{StaticResource IconBucket}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsConnection}" Value="True">
          <Setter Property="Data" Value="{StaticResource IconConnections}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PlaceCellText" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource PageToolbar}"
            Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Hint}" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"
                   Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Height="32" MinHeight="32" Padding="10,0"
                   Command="{Binding BrowseCommand}"
                   ToolTip="{Binding BrowseLabel}"
                   AutomationProperties.Name="{Binding BrowseLabel}">
             <StackPanel Orientation="Horizontal">
               <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconConnections}"
                     Width="16" Height="16" Margin="0,0,8,0"/>
               <TextBlock Text="{Binding BrowseLabel}" VerticalAlignment="Center"/>
             </StackPanel>
           </Button>
          <Border Style="{StaticResource PlaceToolDivider}"
                  Visibility="{Binding ShowClear, Converter={StaticResource BoolVis}}"/>
          <Button Style="{StaticResource PlaceToolDanger}"
                  Command="{Binding ClearCommand}"
                  ToolTip="{Binding ClearLabel}"
                  AutomationProperties.Name="{Binding ClearLabel}"
                  Visibility="{Binding ShowClear, Converter={StaticResource BoolVis}}">
            <Path Style="{StaticResource IconGlyph}" Data="{StaticResource IconTrash}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Style="{StaticResource PageEmptyHost}"
                TextBlock.TextAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}">
      <Border Style="{StaticResource PageEmptyIcon}">
        <Path>
          <Path.Style>
            <Style TargetType="Path" BasedOn="{StaticResource PageEmptyGlyph}">
              <Setter Property="Data" Value="{StaticResource IconClock}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                  <Setter Property="Data" Value="{StaticResource IconStar}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
      </Border>
      <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource PageEmptyTitle}"/>
      <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource PageEmptyDescription}"/>
      <Button Content="{Binding BrowseLabel}" Command="{Binding BrowseCommand}"
              Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
              Margin="0,20,0,0" AutomationProperties.Name="{Binding BrowseLabel}"/>
    </StackPanel>

    <DataGrid x:Name="PlacesGrid" Grid.Row="1" ItemsSource="{Binding Items}"
              ColumnHeaderStyle="{StaticResource SortableListColumnHeader}" Sorting="PlacesGrid_Sorting"
                SizeChanged="PlacesGrid_SizeChanged"
              Visibility="{Binding HasItems, Converter={StaticResource BoolVis}}"
              SelectionMode="Single"
              MouseDoubleClick="PlacesGrid_MouseDoubleClick"
              PreviewMouseRightButtonDown="PlacesGrid_PreviewMouseRightButtonDown"
              PreviewKeyDown="PlacesGrid_PreviewKeyDown"
              SelectionChanged="PlacesGrid_SelectionChanged"
              AutomationProperties.Name="{Binding Hint}">
      <DataGrid.ContextMenu>
        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
          <MenuItem Header="{Binding OpenLabel}"
                    InputGestureText="Enter"
                    Command="{Binding OpenCommand}"
                    CommandParameter="{Binding Selected}"
                    IsEnabled="{Binding HasSelection}">
            <MenuItem.Icon><Path Style="{StaticResource ContextMenuIconStyle}" Data="{StaticResource IconTrayOpen}"/></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="{Binding OpenNewTabLabel}"
                    InputGestureText="Ctrl+Enter"
                    Command="{Binding OpenNewTabCommand}"
                    CommandParameter="{Binding Selected}"
                    IsEnabled="{Binding HasSelection}">
            <MenuItem.Icon><Path Style="{StaticResource ContextMenuIconStyle}" Data="{StaticResource IconOpenNewTab}"/></MenuItem.Icon>
          </MenuItem>
          <Separator Style="{StaticResource ContextMenuSeparatorStyle}"/>
          <MenuItem Header="{Binding RemoveLabel}"
                    InputGestureText="Delete"
                    Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding Selected}"
                    IsEnabled="{Binding HasSelection}"
                    controls:MenuAssist.IsDanger="True">
            <MenuItem.Icon><Path Style="{StaticResource ContextMenuDangerIconStyle}" Data="{StaticResource IconTrash}"/></MenuItem.Icon>
          </MenuItem>
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTemplateColumn x:Name="NameColumn" Width="*" MinWidth="180" SortMemberPath="Title">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                <Path Style="{StaticResource PlaceGlyph}"/>
                <TextBlock Text="{Binding Title}" Style="{StaticResource PlaceCellText}"/>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn x:Name="ConnectionColumn" Binding="{Binding ConnectionName}" Width="180" SortMemberPath="ConnectionName">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceCellText}">
              <Setter Property="ToolTip" Value="{Binding ConnectionName}"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="LocationColumn" Binding="{Binding Location}" Width="2*" MinWidth="180" SortMemberPath="Location">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceCellText}">
              <Setter Property="ToolTip" Value="{Binding Location}"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn x:Name="VisitedColumn" Binding="{Binding VisitedText}" Width="180" SortMemberPath="VisitedAt">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock" BasedOn="{StaticResource PlaceCellText}"/>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
