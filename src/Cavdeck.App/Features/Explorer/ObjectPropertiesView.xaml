<UserControl x:Class="Cavdeck.App.Features.Explorer.ObjectPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding ObjectName}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
               Foreground="{DynamicResource PrimaryTextBrush}"/>
    <TextBlock Text="{Binding ConnectionName}" Margin="0,4,0,12" TextWrapping="Wrap"
               Foreground="{DynamicResource MutedTextBrush}"/>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" x:Name="ReloadButton" Content="{Binding Texts[Explorer_RefreshMenu]}"
              Style="{StaticResource GhostButton}" Click="Reload_Click"/>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="GeneralButton" Content="{Binding Texts[Metadata_General]}" Style="{StaticResource SecondaryButton}"
                Click="General_Click" Margin="0,0,4,0"/>
        <Button x:Name="MetadataButton" Content="{Binding Texts[Metadata_Title]}" Style="{StaticResource GhostButton}"
                Click="Metadata_Click"/>
      </StackPanel>
    </DockPanel>
    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="3" Visibility="Collapsed"
                 AutomationProperties.Name="{Binding Texts[Explorer_Loading]}"/>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,8"
               Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite"/>
    <StackPanel x:Name="Facts"/>
    <WrapPanel x:Name="Actions" Margin="0,12,0,0" Visibility="Collapsed">
      <Button x:Name="EditButton" Content="{Binding Texts[Metadata_Edit]}" Style="{StaticResource SecondaryButton}"
              Click="Edit_Click" Margin="0,0,8,4"/>
      <Button Content="{Binding Texts[Metadata_Copy]}" Style="{StaticResource GhostButton}"
              Click="Copy_Click" Margin="0,0,0,4"/>
    </WrapPanel>
  </StackPanel>
</UserControl>
